rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read access for books catalogue and scoring transparency to all visitors
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Full authenticated access for registered college staff and students
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
